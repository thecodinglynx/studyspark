{
  "name": "studyspark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy --schema prisma/schema.prisma && next build",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "admin:grant": "node --env-file=.env scripts/set-admin.mjs grant",
    "admin:revoke": "node --env-file=.env scripts/set-admin.mjs revoke"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.0.2",
    "autoprefixer": "^10.4.18",
    "bcryptjs": "^2.4.3",
    "bufferutil": "^4.0.8",
    "chart.js": "^4.5.1",
    "next": "^16.4.6",
    "next-auth": "^4.24.7",
    "postcss": "^8.4.38",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "ws": "^8.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.0",
    "postcss-load-config": "^4.0.2",
    "prisma": "^6.19.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
